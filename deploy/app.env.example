# Copy to /srv/opentalking/shared/runtime/app.env, chmod 600.
# The complete configuration reference is the repository root .env.example.
OPENTALKING_AUTH_ENABLED=true
# Plain HTTP on a public IP; switch to true when trusted HTTPS is configured.
OPENTALKING_AUTH_COOKIE_SECURE=false
OPENTALKING_BILLING_DEMO_ENABLED=false
OPENTALKING_DEFAULT_MODEL=mock
OPENTALKING_INFERENCE_MOCK=1
OPENTALKING_STT_DEFAULT_PROVIDER=dashscope
OPENTALKING_STT_ENABLED_PROVIDERS=dashscope
OPENTALKING_TTS_DEFAULT_PROVIDER=edge
OPENTALKING_TTS_ENABLED_PROVIDERS=edge,dashscope,cosyvoice
OPENTALKING_LLM_PROVIDER=openai_compatible
OPENTALKING_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENTALKING_LLM_MODEL=qwen-flash
OPENTALKING_LLM_API_KEY=
OPENTALKING_STT_DASHSCOPE_MODEL=paraformer-realtime-v2
OPENTALKING_STT_DASHSCOPE_API_KEY=
OPENTALKING_TTS_DASHSCOPE_API_KEY=
OPENTALKING_SMS_PROVIDER=spug
OPENTALKING_SPUG_SMS_TEMPLATE_CODE=
